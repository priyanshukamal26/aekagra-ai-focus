# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:8080

# Authentication (Generate a secure random string in production)
JWT_SECRET=your_jwt_super_secret_change_in_production

# Database (Path to SQLite database or :memory: for ephemeral tests)
DATABASE_PATH=./server/aekagra.db

# Cloud AI Integration (Optional: Leave empty for offline stub fallback)
GEMINI_API_KEY=

# Local AI Integration (Optional: Default Ollama port)
OLLAMA_HOST=http://localhost:11434
